{
  "name": "vue-sentinel-x-vite-plugin",
  "version": "0.1.0",
  "description": "Vite plugin for Vue Sentinel X — static component graph analysis, incremental build reports, and Intelligence Engine integration",
  "keywords": [
    "vue",
    "vue3",
    "vite",
    "vite-plugin",
    "component-graph",
    "static-analysis",
    "devtools"
  ],
  "license": "MIT",
  "author": "Amir Maghami",
  "homepage": "https://github.com/amirrr1987/vue-sentinel-x#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amirrr1987/vue-sentinel-x.git",
    "directory": "packages/vite-plugin"
  },
  "bugs": {
    "url": "https://github.com/amirrr1987/vue-sentinel-x/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "vue-sentinel-x-core": "^0.1.0",
    "@vue/compiler-sfc": "^3.5.16"
  },
  "peerDependencies": {
    "vite": "^5.4.0 || ^6.0.0 || ^7.0.0"
  },
  "devDependencies": {
    "vue-sentinel-x-core": "*",
    "@types/node": "^22.15.21",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "publishConfig": {
    "access": "public"
  }
}