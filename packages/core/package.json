{
  "name": "@vue-sentinel-x/core",
  "version": "0.0.1",
  "description": "Intelligence Engine, rules, reports, and shared config for Vue Sentinel X",
  "type": "module",
  "license": "MIT",
  "author": "Amir Maghami",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amirrr1987/vue-sentinel-x.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/amirrr1987/vue-sentinel-x#readme",
  "bugs": {
    "url": "https://github.com/amirrr1987/vue-sentinel-x/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "performance",
    "lint",
    "analysis",
    "memory-leak",
    "devtools"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node ../../scripts/clean-dist.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "typescript": "^5.8.3",
    "vitest": "^4.1.0"
  }
}
