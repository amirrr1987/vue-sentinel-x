{
  "name": "@vue-sentinel-x/runtime",
  "version": "0.0.1",
  "description": "Vue 3 runtime plugin for lifecycle, memory leak, and performance tracking",
  "type": "module",
  "license": "MIT",
  "author": "Amir Maghami",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amirrr1987/vue-sentinel-x.git",
    "directory": "packages/runtime"
  },
  "homepage": "https://github.com/amirrr1987/vue-sentinel-x#readme",
  "bugs": {
    "url": "https://github.com/amirrr1987/vue-sentinel-x/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "performance",
    "memory-leak",
    "devtools",
    "monitoring"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node ../../scripts/clean-dist.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@vue-sentinel-x/core": "^0.0.1"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vue-sentinel-x/core": "workspace:*",
    "typescript": "^5.8.3",
    "vue": "^3.5.16"
  }
}
